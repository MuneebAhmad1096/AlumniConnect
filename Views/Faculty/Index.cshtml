@model IEnumerable<AlumniConnect.Models.Project>
@{
    ViewData["Title"] = "Faculty Review Portal";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold text-primary mb-0">Faculty Review Portal</h2>
        <p class="text-muted small mb-0">Approve or reject submitted Final Year Projects instantaneously.</p>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Student</th>
                    <th>Domain</th>
                    <th>Thesis</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var badgeClass = item.Status == "Approved" ? "bg-success"
                                   : item.Status == "Rejected" ? "bg-danger"
                                   : "bg-warning text-dark";
                    <tr id="row-@item.Id">
                        <td class="fw-semibold">@item.Title</td>
                        <td>@item.AuthorName <br /><small class="text-muted">@item.RollNumber</small></td>
                        <td><span class="badge bg-secondary">@item.Domain</span></td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.PdfFilePath))
                            {
                                <a href="@item.PdfFilePath" target="_blank" class="btn btn-sm btn-outline-primary">View PDF</a>
                            }
                            else
                            {
                                <span class="text-muted small">No PDF</span>
                            }
                        </td>
                        <td>
                            <span id="status-badge-@item.Id" class="badge @badgeClass">@item.Status</span>
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-success btn-status" data-id="@item.Id" data-status="Approved">
                                Approve
                            </button>
                            <button type="button" class="btn btn-sm btn-danger btn-status" data-id="@item.Id" data-status="Rejected">
                                Reject
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $(".btn-status").on("click", function() {
                const projectId = $(this).data("id");
                const targetStatus = $(this).data("status");

                $.post("/Faculty/UpdateStatus", { id: projectId, status: targetStatus }, function(res) {
                    if (res.success) {
                        const badge = $("#status-badge-" + projectId);
                        badge.text(res.newStatus);
                        badge.removeClass("bg-warning text-dark bg-success bg-danger");

                        if (res.newStatus === "Approved") {
                            badge.addClass("bg-success");
                        } else {
                            badge.addClass("bg-danger");
                        }
                    } else {
                        alert("Failed to update project status.");
                    }
                });
            });
        });
    </script>
}