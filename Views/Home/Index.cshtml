@model IEnumerable<AlumniConnect.Models.Project>
@{
    ViewData["Title"] = "Capstone Archive";
    string currentDomain = ViewBag.CurrentDomain ?? "All";
    string[] domains = { "All", "AI & Machine Learning", "Web & Mobile", "Cybersecurity", "Data Science", "IoT & Embedded" };
}

<div class="p-4 mb-4 bg-light rounded-3 border">
    <h1 class="fw-bold text-primary">AlumniConnect — Capstone Project Archive</h1>
    <p class="text-muted mb-3">Explore approved Final Year Projects from the Department of Software Engineering.</p>

    <div class="row g-2 mb-3">
        <div class="col-md-8">
            <input type="text" id="searchInput" value="@ViewBag.CurrentSearch" class="form-control"
                   placeholder="Search by project title, student name, or supervisor..." />
        </div>
        <div class="col-md-4">
            <button type="button" id="btnSearch" class="btn btn-primary w-100">Search Archive</button>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2" id="domainPills">
        @foreach (var d in domains)
        {
            var activeClass = currentDomain == d ? "btn-primary" : "btn-outline-primary";
            <button type="button" class="btn btn-sm @activeClass domain-btn" data-domain="@d">@d</button>
        }
    </div>
</div>

<div class="row g-4" id="projectsContainer">
    <partial name="_ProjectCardsPartial" model="Model" />
</div>

@await Component.InvokeAsync("RecentProjects", new { count = 3 })

@section Scripts {
    <script>
        $(document).ready(function () {
            let selectedDomain = "@currentDomain";

            function loadProjects() {
                const searchTerm = $("#searchInput").val();
                $.get("/Home/SearchProjects", { search: searchTerm, domain: selectedDomain }, function (htmlResult) {
                    $("#projectsContainer").html(htmlResult);
                });
            }

            $("#btnSearch").on("click", loadProjects);

            $("#searchInput").on("keyup", function () {
                loadProjects();
            });

            $(".domain-btn").on("click", function () {
                $(".domain-btn").removeClass("btn-primary").addClass("btn-outline-primary");
                $(this).removeClass("btn-outline-primary").addClass("btn-primary");
                selectedDomain = $(this).data("domain");
                loadProjects();
            });
        });
    </script>
}