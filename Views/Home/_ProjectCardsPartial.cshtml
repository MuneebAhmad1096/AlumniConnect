@model IEnumerable<AlumniConnect.Models.Project>

@if (!Model.Any())
{
    <div class="col-12">
        <div class="alert alert-info text-center">No approved projects match your filter.</div>
    </div>
}
else
{
    @foreach (var item in Model)
    {
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-primary">@item.Domain</span>
                        <small class="text-muted">@item.SubmittedDate.ToString("MMM yyyy")</small>
                    </div>
                    <h5 class="card-title fw-bold">@item.Title</h5>
                    <p class="card-text text-muted small flex-grow-1">@item.Description</p>
                    <hr class="my-2" />
                    <div class="small mb-2">
                        <div><strong>Author:</strong> @item.AuthorName (@item.RollNumber)</div>
                        <div><strong>Supervisor:</strong> @item.SupervisorName</div>
                    </div>
                    @if (!string.IsNullOrEmpty(item.PdfFilePath))
                    {
                        <a href="@item.PdfFilePath" target="_blank" class="btn btn-sm btn-outline-primary w-100 mt-auto">
                            View Thesis PDF
                        </a>
                    }
                </div>
            </div>
        </div>
    }
}